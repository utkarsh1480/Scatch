<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login Page</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Poppins',sans-serif;
}

body{
  height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  background:linear-gradient(135deg,#00b4db,#0083b0);
}

/* MAIN CARD */
.container{
  width:900px;
  height:550px;
  background:#f2f2f2;
  border-radius:25px;
  display:flex;
  overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,0.3);
}

/* LEFT FORM SIDE */
.left{
  width:50%;
  padding:60px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.logo{
  color:#4b5d91;
  font-weight:600;
  margin-bottom:10px;
}

.left h2{
  margin-bottom:30px;
  font-size:28px;
}

.input-box{
  margin-bottom:20px;
}

.input-box input{
  width:100%;
  padding:14px 20px;
  border-radius:30px;
  border:1px solid #ddd;
  outline:none;
  background:#fff;
}

.forgot{
  font-size:12px;
  margin-top:-10px;
  margin-bottom:20px;
  color:#4b5d91;
  cursor:pointer;
}

.signin-btn{
  background:#b12b5b;
  color:white;
  padding:14px;
  border:none;
  border-radius:30px;
  cursor:pointer;
  font-weight:500;
  margin-bottom:20px;
}

.divider{
  text-align:center;
  font-size:13px;
  margin:15px 0;
  color:#777;
}

.social{
  display:flex;
  justify-content:center;
  gap:15px;
}

.social div{
  width:45px;
  height:45px;
  border:1px solid #ccc;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
}

.register{
  text-align:center;
  font-size:13px;
  margin-top:20px;
}

.register span{
  color:#4b5d91;
  font-weight:500;
  cursor:pointer;
}

/* RIGHT IMAGE SIDE */
.right{
  width:50%;
  background:#e0e6ec;
  display:flex;
  justify-content:center;
  align-items:center;
}

.right img{
  width:80%;
}

</style>
</head>

<body>

<div class="container">

  <!-- LEFT SIDE -->
  <div class="left">
    <div class="logo">Scatch</div>
    <h2>Login</h2>
    <form target="/login" method="post" >
    <div class="input-box">
      <input type="email" placeholder="username@gmail.com" name="email">
    </div>

    <div class="input-box">
      <input type="password" placeholder="Password" name="password">
    </div>

    <div class="forgot">Forgot Password?</div>

    <button class="signin-btn">Sign in</button>

    <div class="divider">or continue with</div>

    <div class="social">
      <div>G</div>
      <div>🐙</div>
      <div>f</div>
    </div>

    <div class="register">
      Don’t have an account yet? <span> <a href="signup" >Register for free</a></span>
    </div>
  </div>

  <!-- RIGHT SIDE -->
  <div class="right">
    <img src="https://cdn-icons-png.flaticon.com/512/3063/3063826.png" alt="illustration">
  </div>
</form>
</div>

</body>
</html>